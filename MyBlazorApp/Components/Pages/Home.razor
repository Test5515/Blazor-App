@page "/"
@using MyBlazorApp.Models
@using MyBlazorApp.Services
@inject BlogService BlogService
@inject NavigationManager Navigation

<PageTitle>Blog</PageTitle>

<h1>Blog Posts</h1>

@if (_blogPosts == null || !_blogPosts.Any())
{
    <p>No blog posts yet.</p>
}
else
{
    <ul>
        @foreach (var post in _blogPosts)
        {
            <li>
                <a href="@($"/post/{post.Id}")">@post.Title</a>
                <p><small>By @post.Author on @post.CreatedAt.ToShortDateString()</small></p>
            </li>
        }
    </ul>
}

@code {
    private List<BlogPost> _blogPosts = new List<BlogPost>();

    protected override void OnInitialized()
    {
        _blogPosts = BlogService.GetAllPosts();
    }
}
