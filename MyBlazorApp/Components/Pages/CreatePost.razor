@page "/create"
@using MyBlazorApp.Models
@using MyBlazorApp.Services
@inject BlogService BlogService
@inject NavigationManager Navigation

<PageTitle>Create Post</PageTitle>

<h1>Create New Post</h1>

<EditForm Model="@_newPost" OnValidSubmit="@HandleSubmit">
    <DataAnnotationsValidator /> 
    <ValidationSummary />

    <div class="mb-3">
        <label for="title" class="form-label">Title:</label>
        <InputText id="title" class="form-control" @bind-Value="_newPost.Title" />
    </div>

    <div class="mb-3">
        <label for="author" class="form-label">Author:</label>
        <InputText id="author" class="form-control" @bind-Value="_newPost.Author" />
    </div>

    <div class="mb-3">
        <label for="content" class="form-label">Content:</label>
        <InputTextArea id="content" class="form-control" @bind-Value="_newPost.Content" rows="5" />
    </div>

    <button type="submit" class="btn btn-primary">Create Post</button>
</EditForm>

@code {
    private BlogPost _newPost = new BlogPost();

    private void HandleSubmit()
    {
        BlogService.AddPost(_newPost);
        Navigation.NavigateTo("/");
    }
}
